rules_version = '2';
// Clocktower Daily: who may read and write what.
// Paste this into the Firebase console: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function now() { return request.time.toMillis(); }
    function str(s, max) { return s is string && s.size() > 0 && s.size() <= max; }

    // The public key for phone notifications (the server writes it the first time it runs)
    match /pub/{doc} {
      allow get: if true;
    }
    match /games/{gid} {
      function G() { return get(/databases/$(db)/documents/games/$(gid)).data; }
      function isST() { return signedIn() && G().st == request.auth.uid; }
      // The player in seat pid is whoever the Storyteller linked to that seat
      function owns(pid) { return signedIn() && G().uids.get(pid, '') == request.auth.uid; }
      function dayT(d) { return G().days.get(d, {}); }
      function nominating(d) { return dayT(d).get('noms', 9000000000000000) <= now() && now() < dayT(d).get('close', 0); }
      function closed(d) { return now() >= dayT(d).get('close', 9000000000000000); }
      // The nominee's time to give a defence (minutes), and when new nominations stop
      function defMs() { return G().get('defMins', 30) * 60000; }
      // New nominations stop when voting opens (older games: a defence's length before voting closes)
      function canNominate(d) { return nominating(d) && now() < dayT(d).get('vote', dayT(d).get('close', 0) - defMs()); }
      function near(t) { return t is number && t > now() - 120000 && t < now() + 120000; }
      // Voting on a nomination opens when the nominee gives a defence, or when their time is up
      // Voting opens on every nomination at the day's "Voting opens" time (older games: after the nominee's defence, or its time)
      function votingOpen(d, nom) { let x = get(/databases/$(db)/documents/games/$(gid)/days/$(d)/noms/$(nom)).data; return (dayT(d).get('vote', 0) > 0 && now() >= dayT(d).get('vote', 0)) || (dayT(d).get('vote', 0) == 0 && (x.get('defAt', 0) > 0 || now() >= x.at + defMs())); }

      // The Shadows: when players may talk, and who's out of the game
      function shd() { return G().get('kind', '') == 'shadows'; }
      function today() { return G().days.get(string(G().get('day', 0)), {}); }
      function tonight() { return G().nights.get(string(G().get('day', 0) + 1), {}); }
      function inWin(t, a, b) { return t.get(a, 9000000000000000) <= now() && now() < t.get(b, 0); }
      function isOut(pid) { return get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.get('out', false) == true; }
      // A seduction or blackmail offer not yet answered (and not yet run out): the player can't contribute until they decide
      function offerPending(pid) {
        let o = get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.get('offer', null);
        return o != null && now() < o.until && !exists(/databases/$(db)/documents/games/$(gid)/nights/$(string(o.n))/answers/$(pid));
      }
      function inGhosts() { return signedIn() && get(/databases/$(db)/documents/games/$(gid)/st/grim).data.get('ou', {}).get(request.auth.uid, false) == true; }

      // The public game: anyone with the code can read it; only the Storyteller who made it can change it
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.st == request.auth.uid;
      allow update: if signedIn() && resource.data.st == request.auth.uid && request.resource.data.get('st', resource.data.st) == resource.data.st;
      allow delete: if signedIn() && resource.data.st == request.auth.uid;

      // Asking to join: a player writes their own name
      match /joins/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid && str(request.resource.data.name, 30);
        allow get: if signedIn() && request.auth.uid == uid || isST();
        allow list, delete: if isST();
      }
      // A player's character, side and night info: only them and the Storyteller
      match /secret/{pid} {
        allow get: if isST() || owns(pid);
        allow list, write: if isST();
      }
      // The Storyteller's own Grimoire
      match /st/{doc=**} {
        allow read, write: if isST();
      }
      // News that waits for its moment (the dawn deaths, the execution): readable from time 'at'
      match /gated/{id} {
        allow get: if isST() || resource == null || resource.data.at <= now();
        allow list, write: if isST();
      }
      // Nominations: one per nominator and one per nominee each day, with a reason; the nominee may add a defence
      match /days/{d}/noms/{nominee} {
        allow read: if signedIn();
        allow create: if owns(request.resource.data.by) && request.resource.data.of == nominee && canNominate(d)
          && near(request.resource.data.at) && str(request.resource.data.reason, 300) && !('defAt' in request.resource.data)
          && existsAfter(/databases/$(db)/documents/games/$(gid)/days/$(d)/nominators/$(request.resource.data.by));
        allow update: if isST() || (owns(nominee) && now() < dayT(d).get('close', 0)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defence', 'defAt'])
          && str(request.resource.data.defence, 600) && near(request.resource.data.defAt));
        allow delete: if isST();
      }
      match /days/{d}/nominators/{by} {
        allow read: if signedIn();
        allow create: if owns(by) && canNominate(d);
        allow update, delete: if isST();
      }
      // Votes (only "yes" votes are stored, as nom_voter): secret until voting closes, except your own
      match /days/{d}/votes/{vid} {
        allow get: if isST() || closed(d) || owns(vid.split('_')[1]);
        allow list: if isST() || closed(d);
        allow create: if owns(vid.split('_')[1]) && nominating(d)
          && request.resource.data.voter == vid.split('_')[1] && request.resource.data.nom == vid.split('_')[0]
          && exists(/databases/$(db)/documents/games/$(gid)/days/$(d)/noms/$(vid.split('_')[0])) && votingOpen(d, vid.split('_')[0]);
        allow delete: if (owns(vid.split('_')[1]) && nominating(d)) || isST();
        allow update: if false;
      }
      // The town square: public messages
      match /square/{id} {
        allow read: if signedIn();
        // (The Shadows: only during the round table discussion, and not once you're out)
        allow create: if (owns(request.resource.data.pid) && request.resource.data.kind in ['say', 'slay'] && str(request.resource.data.text, 600)
          && (!shd() || (inWin(today(), 'noms', 'vote') && !isOut(request.resource.data.pid) && !offerPending(request.resource.data.pid)))) || isST();
        allow update, delete: if isST();
      }
      // Private chats between two players (pair = "p1~p2"): only those two can read or write
      match /chats/{pair}/msgs/{id} {
        allow read: if owns(pair.split('~')[0]) || owns(pair.split('~')[1]);
        allow create: if request.resource.data.from in pair.split('~') && owns(request.resource.data.from) && str(request.resource.data.text, 1000)
          && (!shd() || (inWin(today(), 'dawn', 'noms') && !isOut(request.resource.data.from) && !offerPending(request.resource.data.from)))   // The Shadows: breakfast until the round table
          && (!('share' in request.resource.data) || shareOk(request.resource.data));
      }
      // A player's private chat with the Storyteller: only the two of them can read it
      match /stchat/{pid}/msgs/{id} {
        allow read: if isST() || owns(pid);
        allow create: if str(request.resource.data.text, 1000)
          && ((owns(pid) && request.resource.data.from == pid) || (isST() && request.resource.data.from == 'st'));
      }
      // Phone notifications: each device saves its own push subscription, for its own seat (or as the Storyteller)
      match /push/{uid} {
        allow get, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.sub is map
          && ((request.resource.data.role == 'st' && isST()) || (request.resource.data.role == 'player' && owns(request.resource.data.pid)));
      }
      // The Shadows: the Shadows' own chat. Only the Shadows still in the game (their devices are listed by the host
      // in the hidden st/grim, as cu) and the host can read it.
      function inConclave() { return signedIn() && get(/databases/$(db)/documents/games/$(gid)/st/grim).data.get('cu', {}).get(request.auth.uid, false) == true; }
      match /conclave/{id} {
        allow read: if isST() || inConclave();
        allow create: if str(request.resource.data.text, 1000) && request.resource.data.at is number
          && ((isST() && request.resource.data.from == 'host') || (inConclave() && owns(request.resource.data.from) && inWin(tonight(), 'open', 'end')));
      }
      // The Shadows: the dead's own chat. Only the players out of the game (listed by the host as ou) and the host.
      match /ghosts/{id} {
        allow read: if isST() || inGhosts();
        allow create: if str(request.resource.data.text, 1000) && request.resource.data.at is number
          && ((isST() && request.resource.data.from == 'host') || (inGhosts() && owns(request.resource.data.from)));
      }
      // The Shadows: each player's vote at the round table (one each, changeable), secret until voting closes
      match /days/{d}/ballots/{voter} {
        allow get: if isST() || owns(voter) || closed(d);
        allow list: if isST() || closed(d);
        allow create, update: if owns(voter) && !isOut(voter) && (!shd() || !offerPending(voter)) && request.resource.data.voter == voter && request.resource.data.of is string && request.resource.data.of != voter
          && dayT(d).get('vote', 9000000000000000) <= now() && now() < dayT(d).get('close', 0)
          && request.resource.data.keys().hasOnly(['voter', 'of', 'at', 'reason']) && (!('reason' in request.resource.data) || str(request.resource.data.reason, 300));
        allow delete: if isST();
      }
      // The Shadows: a seduction or blackmail offer, answered by the player it went to, before its deadline
      match /nights/{n}/answers/{pid} {
        allow get: if isST() || owns(pid);
        allow list: if isST();
        allow create: if owns(pid) && request.resource.data.keys().hasOnly(['answer', 'at']) && request.resource.data.answer in ['accept', 'refuse']
          && string(get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.offer.n) == n
          && now() < get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.offer.until;
      }
      // The Shadows, the Combination: a digit shared with the button must be the sender's own place and digit,
      // except one false digit per Shadow per day (marked by creating their lies/ doc in the same write, which can only happen once)
      function shareOk(m) {
        let c = get(/databases/$(db)/documents/games/$(gid)/secret/$(m.from)).data;
        let lie = /databases/$(db)/documents/games/$(gid)/days/$(string(c.combo.d))/lies/$(m.from);
        return m.share.keys().hasOnly(['pos', 'digit']) && m.share.pos == c.combo.pos && m.share.digit is string && m.share.digit.matches('[0-9]')
          && m.text == 'My digit is ' + m.share.digit + ', for place ' + string(m.share.pos + 1) + '.'
          && (m.share.digit == c.combo.digit || (c.side == 'shadow' && !exists(lie) && existsAfter(lie)));
      }
      match /days/{d}/lies/{pid} {
        allow get: if isST() || owns(pid);
        allow create: if owns(pid) && get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.side == 'shadow' && request.resource.data.keys().hasOnly(['at']);
      }
      // The Shadows, the Combination: a player's code entry, between breakfast and the round table. Only the host (and the server) read them.
      match /days/{d}/codes/{id} {
        allow read: if isST();
        allow create: if owns(request.resource.data.pid) && !isOut(request.resource.data.pid) && request.resource.data.keys().hasOnly(['pid', 'code', 'at'])
          && request.resource.data.code is string && request.resource.data.code.size() <= 12
          && dayT(d).get('task', '') == 'combination' && dayT(d).get('dawn', 9000000000000000) <= now() && now() < dayT(d).get('noms', 0);
      }
      // The Shadows, the Lanterns: a player lights their lantern (and names who deserves the shield). Only the host reads them.
      match /days/{d}/lights/{id} {
        allow read: if isST();
        allow create: if owns(request.resource.data.pid) && !isOut(request.resource.data.pid) && request.resource.data.keys().hasOnly(['pid', 'nominee', 'at'])
          && request.resource.data.nominee is string && request.resource.data.nominee != request.resource.data.pid
          && dayT(d).get('task', '') == 'lanterns' && dayT(d).get('dawn', 9000000000000000) <= now() && now() < dayT(d).get('noms', 0);
      }
      // The Shadows, Day 1: each Shadow's guess at who the other Shadows are, until the round table. Only the host (and they) can read it.
      match /days/{d}/finds/{pid} {
        allow get: if isST() || owns(pid);
        allow list: if isST();
        allow create, update: if owns(pid) && get(/databases/$(db)/documents/games/$(gid)/secret/$(pid)).data.side == 'shadow'
          && request.resource.data.keys().hasOnly(['picks', 'at']) && request.resource.data.picks is list && request.resource.data.picks.size() <= 12
          && dayT(d).get('dawn', 9000000000000000) <= now() && now() < dayT(d).get('noms', 0);
      }
      // Night actions: the player's own choices while that night is open
      match /nights/{n}/acts/{pid} {
        allow get: if isST() || owns(pid);
        allow list: if isST();
        allow write: if isST() || (owns(pid) && G().nights.get(n, {}).get('open', 9000000000000000) <= now() && now() < G().nights.get(n, {}).get('end', 0)
          && (!shd() || inConclave()));
      }
    }
  }
}
